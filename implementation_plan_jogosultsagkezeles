          EXISTS (
            SELECT 1 FROM ugyirat_hozzaferes uh
            WHERE uh.ugyirat_id = u.id AND uh.user_id = fp.id
          )
        )
      )
    )
  )
);

-- 4. Irat WRITE: auditor és betekinto SOHA nem írhat
